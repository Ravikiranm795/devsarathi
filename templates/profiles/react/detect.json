{
  "id": "react",
  "displayName": "React",
  "category": "frontend",
  "signals": [
    { "file": "package.json", "dep": "react" },
    { "file": "package.json", "dep": "react-dom" }
  ],
  "excludeWhen": [{ "file": "angular.json" }, { "file": "package.json", "dep": "@angular/core" }],
  "frameworks": [
    { "name": "Next.js", "file": "package.json", "dep": "next" },
    { "name": "React Native", "file": "package.json", "dep": "react-native" },
    { "name": "Remix", "file": "package.json", "dep": "@remix-run/react" },
    { "name": "Gatsby", "file": "package.json", "dep": "gatsby" }
  ],
  "tests": [
    { "name": "Jest", "file": "package.json", "dep": "jest" },
    { "name": "Vitest", "file": "package.json", "dep": "vitest" },
    { "name": "React Testing Library", "file": "package.json", "dep": "@testing-library/react" },
    { "name": "Cypress", "file": "package.json", "dep": "cypress" },
    { "name": "Playwright", "file": "package.json", "dep": "@playwright/test" }
  ],
  "linters": [
    { "name": "ESLint", "file": "package.json", "dep": "eslint" },
    { "name": "Prettier", "file": "package.json", "dep": "prettier" },
    { "name": "Biome", "file": "package.json", "dep": "@biomejs/biome" }
  ],
  "buildTools": [
    { "name": "Vite", "file": "package.json", "dep": "vite" },
    { "name": "Create React App", "file": "package.json", "dep": "react-scripts" },
    { "name": "Next.js", "file": "package.json", "dep": "next" },
    { "name": "webpack", "file": "package.json", "dep": "webpack" }
  ],
  "packageManagers": [
    { "name": "pnpm", "file": "pnpm-lock.yaml" },
    { "name": "yarn", "file": "yarn.lock" },
    { "name": "npm", "file": "package-lock.json" }
  ],
  "stateManagement": [
    { "name": "Redux Toolkit", "file": "package.json", "dep": "@reduxjs/toolkit" },
    { "name": "Redux", "file": "package.json", "dep": "redux" },
    { "name": "Zustand", "file": "package.json", "dep": "zustand" },
    { "name": "MobX", "file": "package.json", "dep": "mobx" },
    { "name": "Recoil", "file": "package.json", "dep": "recoil" },
    { "name": "React Query", "file": "package.json", "dep": "@tanstack/react-query" }
  ]
}
